# DTAP environment: dev
# Your own computer. Copy to deploy/env/dev.env (ignored by Git) and choose a password.
# Never commit the real file: deploy/env/*.env is in .gitignore (security rule S3).

ASPNETCORE_ENVIRONMENT=Development
WEB_PORT=8080
MSSQL_PID=Developer
DB_NAME=ProjectControl
MIGRATE_ON_STARTUP=true

# At least 8 characters with upper case, lower case, digits and symbols. Avoid ';' and quotes.
MSSQL_SA_PASSWORD=change-me

# Images: dev builds them from your working copy (deploy/compose.dev.yml)
API_IMAGE=projectcontrol-api:dev
WEB_IMAGE=projectcontrol-web:dev
