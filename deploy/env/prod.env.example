# DTAP environment: prod
# In CI the values come from the GitHub environment 'production'. Express edition: free for production use.
# Never commit the real file: deploy/env/*.env is in .gitignore (security rule S3).

ASPNETCORE_ENVIRONMENT=Production
WEB_PORT=8083
MSSQL_PID=Express
DB_NAME=ProjectControl
MIGRATE_ON_STARTUP=true

# At least 8 characters with upper case, lower case, digits and symbols. Avoid ';' and quotes.
MSSQL_SA_PASSWORD=change-me

# Images: leave empty to deploy the images CI built for the checked-out commit
# (resolved automatically), or set exact digests, e.g. to deploy an older version:
# API_IMAGE=ghcr.io/team5-vanroey/projectcontrol-api@sha256:...
# WEB_IMAGE=ghcr.io/team5-vanroey/projectcontrol-web@sha256:...
API_IMAGE=
WEB_IMAGE=
