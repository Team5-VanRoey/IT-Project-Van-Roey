<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <!-- cobertura: our own 80% check (scripts/coverage_check.py), opencover: SonarQube -->
          <Format>cobertura,opencover</Format>
          <Exclude>[ProjectControl.ServiceDefaults]*,[ProjectControl.AppHost]*,[ProjectControl.Api]Program</Exclude>
          <ExcludeByFile>**/Migrations/*.cs,**/obj/**/*.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
