#!/bin/sh
# 1. Blocks commits directly on main and develop.
# 2. Checks that the current branch follows the Gitflow naming convention.
# 3. Scans the staged changes for secrets with Gitleaks (Definition of Done).
#    Never skip this hook with --no-verify.

branch=$(git symbolic-ref --short HEAD 2>/dev/null)

# No branch (e.g. during a rebase): skip the branch checks, but still scan for secrets
if [ -n "$branch" ]; then
  case "$branch" in
    main|develop)
      echo ""
      echo "REJECTED: committing directly on '$branch' is not allowed."
      echo "Create a feature branch from develop:"
      echo "  git stash"
      echo "  git checkout develop && git pull"
      echo "  git checkout -b feature/IT2627T05-XX"
      echo "  git stash pop"
      echo ""
      exit 1
      ;;
  esac

  if ! echo "$branch" | grep -Eq '^((feature|bugfix|hotfix)/IT2627T05-[0-9]+(-[A-Za-z0-9_-]+)?|release/[0-9A-Za-z._-]+)$'; then
    echo ""
    echo "REJECTED: branch name '$branch' does not follow the Gitflow convention."
    echo "Allowed:   feature/IT2627T05-XX, bugfix/IT2627T05-XX, hotfix/IT2627T05-XX, release/x.y.z"
    echo "Rename it: git branch -m feature/IT2627T05-XX"
    echo ""
    exit 1
  fi
fi

# Secret scan on the staged changes
if ! command -v gitleaks >/dev/null 2>&1; then
  echo ""
  echo "REJECTED: Gitleaks is not installed, so the staged changes cannot be scanned for secrets."
  echo "Install it and commit again:"
  echo "  Windows: winget install Gitleaks.Gitleaks"
  echo "  macOS:   brew install gitleaks"
  echo "  Linux:   https://github.com/gitleaks/gitleaks/releases"
  echo ""
  exit 1
fi

# Gitleaks 8.19+ uses 'git --pre-commit', older versions use 'protect'
if gitleaks git --help >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --no-banner
else
  gitleaks protect --staged --redact --no-banner
fi
status=$?

if [ "$status" -ne 0 ]; then
  echo ""
  echo "REJECTED: Gitleaks found a possible secret in the staged changes (see above)."
  echo "Remove it from the file, unstage it, and put real values in a .env file (listed in .gitignore)."
  echo ""
  exit 1
fi

exit 0
