#!/bin/sh
# Checks that every commit message starts with a Jira ticket.
# Example: IT2627T05-181: add PR template

msg_file="$1"
first_line=$(head -n 1 "$msg_file")

# Merge and revert commits generated by Git itself are allowed
case "$first_line" in
  Merge*|Revert*) exit 0 ;;
esac

if ! echo "$first_line" | grep -Eq '^IT2627T05-[0-9]+: .+'; then
  echo ""
  echo "REJECTED: the commit message has the wrong format."
  echo "Expected: IT2627T05-XX: short description"
  echo "Got:      $first_line"
  echo ""
  exit 1
fi

exit 0
